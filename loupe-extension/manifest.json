{
  "manifest_version": 3,
  "name": "Loupe",
  "version": "3.1.0",
  "description": "Compare Figma designs against live websites, plus brand, accessibility, and responsive checks.",
  "homepage_url": "https://getloupe.vercel.app",
  "author": "Loupe",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["https://getloupe.vercel.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Loupe — Extract & Compare",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
